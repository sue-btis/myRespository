  "components": [
    {
      "name": "Call-to-action",
      "kind": "button",
      "refersTo": "button-cta-neutral",
      "description": "The single primary action, in the rail.",
      "html": "<a class=\"ds-cta\" href=\"#\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 4h12v8H2zM2 4l6 5 6-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>Write to me</a>",
      "css": ".ds-cta{display:inline-flex;align-items:center;gap:.5em;padding:.7em 1.15em;border-radius:3px;background:#16324A;color:#ECECEC;font-family:Archivo,system-ui,sans-serif;font-weight:650;text-decoration:none;transition:transform .5s linear(0, 0.06 2%, 0.23 5%, 0.5 9%, 0.78 14%, 0.95 19%, 1.035 25%, 1.045 30%, 1.02 40%, 0.995 55%, 1.002 70%, 1)}.ds-cta svg{width:1em;height:1em}.ds-cta:hover{transform:translateY(-2px)}.ds-cta:active{transform:translateY(1px)}.ds-cta:focus-visible{outline:2px solid #16324A;outline-offset:3px}"
    },
    {
      "name": "Module Slot",
      "kind": "custom",
      "refersTo": "slot-neutral",
      "description": "Numbered slot with its palette edge; click inserts or ejects the module.",
      "html": "<button class=\"ds-slot\" type=\"button\" aria-pressed=\"false\"><span class=\"ds-slot__edge\"><i style=\"background:#B23850\"></i><i style=\"background:#3B8BEB\"></i><i style=\"background:#E7E3D4\"></i><i style=\"background:#C4DBF6\"></i><i style=\"background:#8590AA\"></i></span><span class=\"ds-slot__num\">01</span><span class=\"ds-slot__name\">Full-stack &amp; Product</span><span class=\"ds-slot__meta\"><span>1 project</span><b>Insert</b></span></button>",
      "css": ".ds-slot{display:grid;grid-template-rows:10px auto 1fr auto;gap:12px;width:240px;min-height:180px;padding:0 20px 18px;text-align:left;font:inherit;font-family:Archivo,system-ui,sans-serif;color:#16324A;background:#ECECEC;border:1px solid #16324A2E;cursor:pointer;transition:transform .62s linear(0, 0.06 2%, 0.23 5%, 0.5 9%, 0.78 14%, 0.95 19%, 1.035 25%, 1.045 30%, 1.02 40%, 0.995 55%, 1.002 70%, 1)}.ds-slot__edge{display:flex;margin:0 -20px;height:10px}.ds-slot__edge i{flex:1}.ds-slot__num{font-size:2.6rem;font-weight:300;font-variation-settings:\"wdth\" 70;line-height:1;letter-spacing:-.02em;font-variant-numeric:lining-nums tabular-nums}.ds-slot__name{font-size:1.1rem;font-weight:650;line-height:1.2;align-self:end;max-width:14ch}.ds-slot__meta{display:flex;justify-content:space-between;font-size:.8rem;color:#3E5568}.ds-slot__meta b{color:#16324A;font-weight:650}.ds-slot:hover{transform:translateY(-3px)}.ds-slot:focus-visible{outline:2px solid #16324A;outline-offset:3px}"
    },
    {
      "name": "Seated Slot",
      "kind": "custom",
      "refersTo": "slot-seated-neutral",
      "description": "Seated state: the plate lifts onto ground-2 over an offset ink-hairline layer.",
      "html": "<div class=\"ds-seat-wrap\"><button class=\"ds-seated\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-seated__num\">01</span><span>Full-stack &amp; Product</span><span class=\"ds-seated__act\">Eject</span></button></div>",
      "css": ".ds-seat-wrap{padding:12px}.ds-seated{position:relative;isolation:isolate;display:grid;gap:12px;width:220px;padding:24px 20px 18px;text-align:left;font:inherit;font-family:Archivo,system-ui,sans-serif;font-weight:650;color:#16324A;background:#F7F7F7;border:0;transform:translate(-6px,-6px);cursor:pointer}.ds-seated::before{content:\"\";position:absolute;inset:0;z-index:-1;transform:translate(6px,6px);border:1px solid #16324A;background:#ECECEC}.ds-seated__num{font-size:2.6rem;font-weight:300;font-variation-settings:\"wdth\" 70;line-height:1}.ds-seated__act{font-size:.8rem}.ds-seated:focus-visible{outline:2px solid #16324A;outline-offset:3px}"
    },
    {
      "name": "Rail",
      "kind": "nav",
      "refersTo": "rail-neutral",
      "description": "Sticky chassis rail: name, CV, LinkedIn, GitHub, call-to-action.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-rail__name\" href=\"#\">Josue Escobar</a><span class=\"ds-rail__links\"><span class=\"ds-pending\">CV</span><a href=\"#\">GitHub</a><a class=\"ds-rail__cta\" href=\"#\">Write to me</a></span></nav>",
      "css": ".ds-rail{display:flex;align-items:center;justify-content:space-between;gap:16px;height:64px;padding:0 24px;background:#ECECEC;border-bottom:1px solid #16324A2E;font-family:Archivo,system-ui,sans-serif;color:#16324A}.ds-rail__name{font-weight:700;font-variation-settings:\"wdth\" 112;color:inherit;text-decoration:none}.ds-rail__links{display:flex;align-items:center;gap:20px;font-size:.875rem}.ds-rail__links a:not(.ds-rail__cta){color:#3E5568;text-decoration:none}.ds-rail__links a:not(.ds-rail__cta):hover{color:#16324A;text-decoration:underline}.ds-pending{color:#3E5568;text-decoration:underline dashed;text-underline-offset:.22em;cursor:help}.ds-rail__cta{padding:.7em 1.15em;border-radius:3px;background:#16324A;color:#ECECEC;font-weight:650;text-decoration:none}.ds-rail a:focus-visible{outline:2px solid #16324A;outline-offset:3px}"
    },
    {
      "name": "Pending Link",
      "kind": "chip",
      "description": "A link without a target: dashed, muted, never reads as live.",
      "html": "<span class=\"ds-pending-link\" tabindex=\"0\">LinkedIn</span> <span class=\"ds-pending-tag\">Live demo · URL pending</span>",
      "css": ".ds-pending-link{font-family:Archivo,system-ui,sans-serif;color:#3E5568;text-decoration:underline dashed;text-underline-offset:.22em;text-decoration-thickness:1px;cursor:help}.ds-pending-link:focus-visible{outline:2px solid #16324A;outline-offset:3px;border-radius:3px}.ds-pending-tag{font-family:Archivo,system-ui,sans-serif;font-size:.8rem;color:#3E5568;border:1px dashed #16324A33;padding:.35em .6em;border-radius:3px}"
    },
    {
      "name": "Project Plate (region)",
